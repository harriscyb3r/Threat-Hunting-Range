# (hr_kusto), never in the repo.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Node / frontend ──────────────────────────────────────────────────────
node_modules/
dist/
app/dist/
*.tsbuildinfo
.vite/

# ── Editors & OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

