# Kusto Threat Hunting Range — backend settings.
#
# Copy to backend/.env and edit. Every value below is the default that
# config.py already uses, so an empty .env (or none at all) works fine —
# this file exists to document what is tunable.
#
# Every setting is also settable as a RANGE_-prefixed environment variable,
# which is how docker-compose points the containerised backend at the `kusto`
# service instead of localhost.

# ── Paths ───────────────────────────────────────────────────────────────
# SQLite campaign/hunt registry. Gitignored; safe to delete to start over
# (the Kusto databases survive — re-register them or rebuild).
RANGE_DATA_DIR=./data
RANGE_DB_PATH=./data/range.db

# ── Server ──────────────────────────────────────────────────────────────
# Loopback only. There is NO authentication — this is a single-user practice
# tool, which is only defensible while it stays unreachable off the machine.
# Do not set 0.0.0.0 on a network you do not control.
RANGE_HOST=127.0.0.1
RANGE_PORT=8780

# ── Kusto engine ────────────────────────────────────────────────────────
# On the host: localhost. Inside compose (--profile app): http://kusto:8080
RANGE_KUSTO_URL=http://localhost:8080

# Path *inside the engine container* where persistent databases live — the
# mount point of the hr_kusto volume, not a host path.
RANGE_KUSTO_DATA_DIR=/kustodata/dbs

# Where THIS process can see the Kusto volume, if at all. A backend run on the
# host against a named volume cannot see it, so deleting a campaign detaches it
# but leaves the files on the volume. Empty means "no access" — purging is
# skipped and reported honestly rather than silently failing.
RANGE_KUSTO_VOLUME_MOUNT=

# A 10k-row .set-or-append is ~1.8 MB of command text, and a cold engine can
# take a few seconds to answer its first query. Raise these, don't lower them.
RANGE_KUSTO_TIMEOUT_S=120
RANGE_KUSTO_READY_TIMEOUT_S=120

# ── Scenario drafting ───────────────────────────────────────────────────
# local        offline heuristic drafter. Free. The default.
# claude-code  drafts via a local Claude Code session. Free.
# api          metered Anthropic API. THE ONLY SETTING THAT CAN SPEND MONEY,
#              and it is never reached unless set here explicitly.
RANGE_DRAFTER=local
